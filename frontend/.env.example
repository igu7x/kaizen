# Variáveis de ambiente do frontend (Vite)
# Copie para .env.local para desenvolvimento local

# ------------------------------------------------------------
# CONTROLE DE AMBIENTE (recomendado para builds no OpenShift)
# Valores: development | staging | production
# ------------------------------------------------------------
# VITE_APP_ENV=production

# ------------------------------------------------------------
# URL da API Backend
# Se definido, sobrescreve VITE_APP_ENV e hostname detection
# ------------------------------------------------------------
# VITE_API_URL=http://localhost:3001

# URLs específicas por ambiente (usadas quando VITE_APP_ENV está definido)
# VITE_API_URL_STAGING=https://painel-sgjt-stag-api.apps.ocp-prd.tjgo.jus.br
# VITE_API_URL_PRODUCTION=https://kaizen-api.tjgo.jus.br

# ------------------------------------------------------------
# Desenvolvimento local (descomente e ajuste)
# ------------------------------------------------------------
VITE_API_URL=http://localhost:3001
