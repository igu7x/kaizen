# Dockerfile multistage para o backend Java do monorepo Kaizen.
#
# Build: rodar a partir da raiz do monorepo:
#   docker build -t kaizen-backend:staging -f deploy/staging/Dockerfile.backend backend/
#
# Stage 1 (build): UBI9 JDK 21 + Maven → gera o jar (skip tests).
# Stage 2 (runtime): UBI9 JRE 21 minimal → roda o jar com TZ fixo.

# ============================================================
# Stage 1 — Build
# ============================================================
FROM registry.access.redhat.com/ubi9/openjdk-21:latest AS build

USER root
WORKDIR /workspace

# Aproveitar cache do Maven (só baixa dependências se pom.xml mudou).
COPY pom.xml ./
RUN mvn -B -q dependency:go-offline

COPY src ./src
RUN mvn -B -q clean package -DskipTests \
    && cp /workspace/target/kaizen-api-java-*.jar /workspace/app.jar

# ============================================================
# Stage 2 — Runtime
# ============================================================
FROM registry.access.redhat.com/ubi9/openjdk-21-runtime:latest

# CRÍTICO: o serializer de java.sql.Date assume America/Sao_Paulo.
# Mudar TZ quebra paridade com o Node em datas.
ENV TZ=America/Sao_Paulo

# Pasta de uploads (ajustar se a infra usar PVC / S3 para anexos).
USER root
RUN mkdir -p /app/uploads \
 && chgrp -R 0 /app \
 && chmod -R g+rwX /app
USER 185

WORKDIR /app
COPY --from=build /workspace/app.jar /app/app.jar

EXPOSE 8081

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD curl -fsS http://localhost:8081/actuator/health || exit 1

# Heap dimensionada via cgroup (OpenShift seta limits pelo Deployment).
ENV JAVA_OPTS="-XX:MaxRAMPercentage=75 -Dfile.encoding=UTF-8 -Duser.timezone=America/Sao_Paulo"

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
