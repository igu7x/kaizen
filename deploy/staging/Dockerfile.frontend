# Dockerfile multistage para o frontend React do monorepo Kaizen.
#
# Build: rodar a partir da raiz do monorepo:
#   docker build -t kaizen-frontend:staging -f deploy/staging/Dockerfile.frontend frontend/
#
# Stage 1 (build): Node 20 + npm → vite build → /dist com arquivos estáticos.
# Stage 2 (runtime): nginx que serve o /dist + faz proxy /api/* para o backend
#                    (alcançado via Service ClusterIP interno do OpenShift).
#
# IMPORTANTE — VITE_API_URL:
#   Em produção/staging do monorepo, deixar VAZIO. O nginx (stage 2) faz proxy
#   de /api/* para o backend. O frontend usa caminhos relativos (/api/users etc).
#   Isso evita CORS e elimina necessidade de expor o backend publicamente.

# ============================================================
# Stage 1 — Build
# ============================================================
FROM registry.access.redhat.com/ubi9/nodejs-20:latest AS build

USER root
WORKDIR /workspace

# Cache de dependências
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# Build de produção
COPY . ./
# VITE_API_URL vazio = chamadas vão pra mesma origem (relativas)
ENV VITE_API_URL=""
ENV VITE_APP_ENV="staging"
RUN npm run build

# ============================================================
# Stage 2 — Runtime (nginx)
# ============================================================
FROM registry.access.redhat.com/ubi9/nginx-122:latest

# Copia config customizada (substitui a default do nginx)
COPY deploy/staging/nginx-frontend.conf /etc/nginx/nginx.conf

# Copia os arquivos estáticos do build
COPY --from=build /workspace/dist /opt/app-root/src/

# OpenShift random UID — UBI já vem com group 0 writable
EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
